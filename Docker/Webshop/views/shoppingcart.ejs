<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>Warenkorb</title>
    <style>
        table { width: 50%; border-collapse: collapse; }
        th, td { padding: 10px; border: 1px solid black; text-align: center; }
        button { padding: 5px; cursor: pointer; }
    </style>
</head>
<body>
    <h1>Hier sehen Sie Ihren Warenkorb</h1>

    <table>
        <tr>
            <th>ID</th>
            <th>Produkt</th>
            <th>Menge</th>
            <th>Preis</th>
            <th>Gesamtpreis</th>
            <th>Aktion</th>
        </tr>
        <% items.forEach(item => { %>
        <tr>
            <td><%= item.ID %></td>
            <td><%= item.ProductName %></td>
            <td><%= item.Amount %></td>
            <td><%= item.Price %>€</td>
            <td><%= (item.Price * item.Amount).toFixed(2) %>€</td>
            <td>
                <form action="/cart/delete/<%= item.ID %>" method="POST">
                    <button type="submit">Löschen</button>
                </form>
            </td>
        </tr>
        <% }); %>
    </table>

    <h2>Gesamtbetrag: <%= total.toFixed(2) %>€</h2>

    <h3>Produkt hinzufügen:</h3>
    <form action="/cart/add" method="POST">
        <input type="text" name="product_name" placeholder="Produktname" required>
        <input type="number" name="amount" placeholder="Menge" required>
        <input type="number" step="0.01" name="price" placeholder="Preis" required>
        <button type="submit">Hinzufügen</button>
    </form>

</body>
</html>

